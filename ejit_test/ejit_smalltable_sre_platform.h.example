/* Historical custom-binding template, kept for callers of the released C ABI.
 * The stock single-C demo no longer includes this file or needs SDK macros.
 * It passes NULL prepare_shared_data/delay_ticks to use runtime's existing SRE
 * scheduler, automatic PASS2 static-object records in the existing period
 * registry, and actual fixed-domain data ranges. No new SDK final-linker bounds,
 * task-self API, or default successful mapping stub are required. Rebuild AOT
 * and runtime together; registry declarations do not prove physical coherence.
 *
 * A product needing a different storage model may STILL provide a genuine
 * ejit_small_table_sre_bindings_t::prepare_shared_data callback. That optional
 * ABI is unchanged; it must prove/install same-VA same-physical coherent
 * READ/WRITE on the actual calling core, reject unknown/private ranges, and
 * return zero only on success. Use the product's real SDK signature rather
 * than inventing an interface here. The stock demo does not require it.
 */
#ifndef YOUR_PR231_SRE_BINDINGS_H
#define YOUR_PR231_SRE_BINDINGS_H

