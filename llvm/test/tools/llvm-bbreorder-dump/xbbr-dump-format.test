## XBBR decision-map binary format negative tests:
##  - format-version mismatch is rejected (was: silently accepted)
##  - num_entries × 32 overflow refused (was: undefined behavior)
##  - graphviz no longer draws self-loop edges (the meaningless
##    self-loop on every "moved" BB because OrigFuncAddr is a
##    placeholder 0)
##  - --graphviz and --summary are mutually exclusive
##
## We hand-craft a tiny ELF whose only "real" content is .debug_xbbr_decision
## via yaml2obj, so the tests don't depend on the linker — they exercise the
## binary parser directly.

# REQUIRES: x86-registered-target

# RUN: rm -rf %t && split-file %s %t && cd %t

## Good case: 1 entry, valid header, exercise human + summary + graphviz.
# RUN: yaml2obj good.yaml -o good.elf
# RUN: llvm-bbreorder-dump --summary good.elf | FileCheck %s --check-prefix=GSUM
# RUN: llvm-bbreorder-dump good.elf | FileCheck %s --check-prefix=GHUM
# RUN: llvm-bbreorder-dump --graphviz good.elf | FileCheck %s --check-prefix=GDOT

## Bad version (major != 1): tool exits 1 with error.
# RUN: yaml2obj bad-version.yaml -o badv.elf
# RUN: not llvm-bbreorder-dump badv.elf 2>&1 | FileCheck %s --check-prefix=BADV

## Mutually-exclusive options.
# RUN: not llvm-bbreorder-dump --graphviz --summary good.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=MUTEX

# GSUM: xbbr-dump: entries=1 moved=1 anchored=0
# GSUM: xbbr-dump: functions=1

# GHUM: XBBR Decision Map
# GHUM: version   : 0x00010000
# GHUM: entries   : 1
# GHUM: Function 0 (1 BBs):
# GHUM: BB  OrigFuncAddr  NewAddr       Cluster  Flag
# GHUM: 0  0x00000000  0x00001000        0  moved

## Graphviz must NOT contain self-loop edges (regression guard for the
## old `node_X -> node_X` bug). Single-BB cluster has no adjacency edges
## at all.
# GDOT:     digraph XBBR {
# GDOT:     subgraph cluster_0
# GDOT-NOT: -> node_f0_b0

# BADV: error: no valid .debug_xbbr_decision section found

# MUTEX: error: --graphviz and --summary are mutually exclusive

#--- good.yaml
--- !ELF
FileHeader:
  Class:           ELFCLASS64
  Data:            ELFDATA2LSB
  Type:            ET_REL
  Machine:         EM_X86_64
Sections:
  - Name:            .debug_xbbr_decision
    Type:            SHT_PROGBITS
    AddressAlign:    8
    ## Header (16B): magic "XBBR" + version 0x00010000 + num_entries 1 + flags 0
    ## Entry (32B):  orig=0  bb=0  new=0x1000  cluster=0  flags=1(moved)  func=0
    ## Layout (offsets):
    ##   0..3  XBBR
    ##   4..7  00000100 (version 0x00010000 LE)
    ##   8..11 01000000 (num_entries=1 LE)
    ##   12..15 00000000 (flags=0)
    ##   16..23 entry orig_func_addr=0
    ##   24..27 entry bb_index=0
    ##   28..35 entry new_address=0x1000 LE  → 0010000000000000
    ##   36..39 entry cluster_id=0
    ##   40..43 entry decision_flags=1 LE   → 01000000 (moved)
    ##   44..47 entry func_id=0
    Content:         '584242520000010001000000000000000000000000000000000000000010000000000000000000000100000000000000'

#--- bad-version.yaml
--- !ELF
FileHeader:
  Class:           ELFCLASS64
  Data:            ELFDATA2LSB
  Type:            ET_REL
  Machine:         EM_X86_64
Sections:
  - Name:            .debug_xbbr_decision
    Type:            SHT_PROGBITS
    AddressAlign:    8
    ## Header with major version = 0x0099 (incompatible).
    Content:         '58424252000099000000000000000000'
