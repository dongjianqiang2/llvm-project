{
  "version": 3,
  "configurePresets": [
    {
      "name": "ejit-minimal",
      "displayName": "EJIT Minimal (size-optimized)",
      "description": "Minimal LLVM build for EmbeddedJIT. Static linking, Release+Os, AArch64 only, LTO, sections GC. Targets <10MB total.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build-ejit-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LLVM_TARGETS_TO_BUILD": "AArch64",
        "BUILD_SHARED_LIBS": "OFF",
        "LLVM_ENABLE_ASSERTIONS": "OFF",
        "LLVM_INCLUDE_TESTS": "OFF",
        "LLVM_INCLUDE_EXAMPLES": "OFF",
        "LLVM_INCLUDE_DOCS": "OFF",
        "LLVM_INCLUDE_BENCHMARKS": "OFF",
        "LLVM_ENABLE_PROJECTS": "clang",
        "LLVM_OPTIMIZED_TABLEGEN": "ON",
        "LLVM_USE_LINKER": "lld",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "LLVM_ENABLE_TERMINFO": "OFF",
        "LLVM_ENABLE_ZLIB": "OFF",
        "LLVM_ENABLE_ZSTD": "OFF",
        "LLVM_ENABLE_LIBXML2": "OFF",
        "CMAKE_C_FLAGS": "-ffunction-sections -fdata-sections -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-ffunction-sections -fdata-sections -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS_RELEASE": "-Os -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-Os -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections -Wl,--strip-all",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections -Wl,--strip-all",
        "CMAKE_STATIC_LINKER_FLAGS": "",
        "EJIT_DEFAULT_TARGET_TRIPLE": ""
      }
    },
    {
      "name": "ejit-minimal-aarch64_be",
      "displayName": "EJIT Minimal (AArch64_be cross-compile)",
      "description": "AArch64_be cross-compilation for EmbeddedJIT minimal build. Requires clang toolchain.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "LLVM_TARGETS_TO_BUILD": "AArch64",
        "BUILD_SHARED_LIBS": "OFF",
        "LLVM_ENABLE_ASSERTIONS": "OFF",
        "LLVM_INCLUDE_TESTS": "OFF",
        "LLVM_INCLUDE_EXAMPLES": "OFF",
        "LLVM_INCLUDE_DOCS": "OFF",
        "LLVM_INCLUDE_BENCHMARKS": "OFF",
        "LLVM_ENABLE_PROJECTS": "clang",
        "LLVM_OPTIMIZED_TABLEGEN": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CROSSCOMPILING": "ON",
        "LLVM_HOST_TRIPLE": "aarch64_be-linux-gnu",
        "LLVM_DEFAULT_TARGET_TRIPLE": "aarch64_be-linux-gnu",
        "EJIT_DEFAULT_TARGET_TRIPLE": "aarch64_be-none-elf",
        "LLVM_ENABLE_TERMINFO": "OFF",
        "LLVM_ENABLE_ZLIB": "OFF",
        "LLVM_ENABLE_ZSTD": "OFF",
        "LLVM_ENABLE_LIBXML2": "OFF",
        "CMAKE_C_FLAGS": "-fno-PIC -ffunction-sections -fdata-sections -fno-omit-frame-pointer -fno-exceptions -DLLVM_ENABLE_EH=OFF -DLLVM_ENABLE_RTTI=OFF -mno-outline-atomics -fno-threadsafe-statics -mllvm -enable-ejit-global-ctors=false -fstack-protector-strong -DEJIT_SRE_SHARED_DUMP_SLOT_TEXT_BYTES=262144",
        "CMAKE_CXX_FLAGS": "-fno-PIC -ffunction-sections -fdata-sections -fno-omit-frame-pointer -fno-exceptions -DLLVM_ENABLE_EH=OFF -DLLVM_ENABLE_RTTI=OFF -mno-outline-atomics -fno-threadsafe-statics -mllvm -enable-ejit-global-ctors=false -fstack-protector-strong -DEJIT_SRE_SHARED_DUMP_SLOT_TEXT_BYTES=262144",
        "CMAKE_C_FLAGS_RELEASE": "-Os -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-Os -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections -Wl,--strip-all",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections -Wl,--strip-all",
        "CMAKE_STATIC_LINKER_FLAGS": "",
        "LLVM_ENABLE_PIC": "OFF",
        "LLVM_ENABLE_THREADS": "OFF",
        "EJIT_TRIM_LLVM_BACKEND": "ON",
        "EJIT_TRIM_LLVM_BACKEND_EXPERIMENTAL": "ON",
        "EJIT_FREESTANDING": "ON",
        "EJIT_CODE_POOL_4K_SEAL": "ON",
        "EJIT_CODE_POOL_BATCHED_PUBLISH": "ON",
        "EJIT_SRE_CODE_POOL": "ON",
        "EJIT_SRE_CODE_POOL_PTNO": "8",
        "EJIT_FIXED_CODE_POOL": "ON",
        "EJIT_CODE_POOL_FIXED_NEAR_HOT": "ON",
        "EJIT_SRE_TASKPOOL": "ON",
        "EJIT_SRE_SHARED_TASKPOOL": "ON",
        "EJIT_SRE_TASKPOOL_NO_RECLAIM": "ON",
        "EJIT_SRE_SHARED_CODE_POINTERS": "ON",
        "EJIT_SRE_SHARED_TASKPOOL_WORKER_CORE": "6",
        "EJIT_SRE_PGO_BRANCH_AUDIT": "ON",
        "EJIT_SRE_PGO_MAX_CONCURRENT_PROFILES": "4",
        "EJIT_SRE_PGO_COLD_PROFILE_TIMEOUT_TICKS": "300000000000",
        "EJIT_SRE_PGO_PUBLISH_QUIET_CYCLES": "30000000000",
        "EJIT_SRE_PGO_COLD_SUPPRESSION_CAPACITY": "128",
        "EJIT_SRE_TASKPOOL_WORKER_STACK_SIZE": "262144",
        "EJIT_SRE_TASKPOOL_WORKER_THROTTLE_MULT": "10",
        "EJIT_SHARED_SECTION_ATTR": "__attribute__((section(\".mc_shared\")))",
        "EJIT_DIAG_ENABLE": "ON",
        "EJIT_DIAG_PRINT_THROTTLE_TICKS": "50",
        "EJIT_SRE_DIAG": "ON",
        "EJIT_DUMP_ASM": "ON",
        "EJIT_STATS_ENABLE": "ON",
        "EJIT_ICACHE_DIM_SIZE": "16"
      }
    },
    {
      "name": "ejit-minimal-aarch64",
      "displayName": "EJIT Minimal (AArch64 cross-compile)",
      "description": "AArch64 (little-endian) cross-compilation for EmbeddedJIT minimal build. Requires aarch64-linux-gnu- toolchain.",
      "inherits": "ejit-minimal",
      "binaryDir": "${sourceDir}/../build-ejit-minimal-aarch64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
        "CMAKE_CROSSCOMPILING": "ON",
        "LLVM_HOST_TRIPLE": "aarch64-linux-gnu",
        "LLVM_DEFAULT_TARGET_TRIPLE": "aarch64-linux-gnu",
        "EJIT_DEFAULT_TARGET_TRIPLE": "aarch64-linux-gnu"
      }
    }
  ]
}
